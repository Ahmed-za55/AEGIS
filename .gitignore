```gitignore
# Python virtual environment
.venv/

# Python cache
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Test coverage
.coverage
htmlcov/

# Environment variables and secrets
.env
.env.*
!.env.example

# Local databases
*.db
*.sqlite
*.sqlite3

# Backup files
*.bak
*.before_*.bak

# Temporary editor files
tempCodeRunnerFile.py

# Generated test artifact
aegis_forbidden_test.txt
```

